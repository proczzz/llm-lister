{
  "name": "llm-lister",
  "version": "0.1.0",
  "description": "Zero-dependency, cross-runtime utility to list available models for an LLM provider given an API key.",
  "homepage": "https://github.com/proczzz/llm-lister#readme",
  "bugs": {
    "url": "https://github.com/proczzz/llm-lister/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proczzz/llm-lister.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "llm",
    "ai",
    "models",
    "deepseek",
    "anthropic"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
